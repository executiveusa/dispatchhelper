FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npm install --no-save esbuild && npm run build \
 && npx esbuild netlify/functions/intake.mts --bundle --format=esm --platform=node \
      --banner:js="globalThis.Netlify={env:{get:(k)=>process.env[k]}}" \
      --outfile=server/intake.bundle.mjs

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
EXPOSE 3000
CMD ["node", "server/server.mjs"]

# Browser-safe self-hosted Supabase settings
VITE_SUPABASE_URL=https://your-self-hosted-supabase.example.com
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only settings: configure in the deployment vault, never in VITE_* variables
SUPABASE_URL=https://your-self-hosted-supabase.example.com
SUPABASE_SERVICE_ROLE_KEY=service-role-key
INTAKE_RATE_LIMIT_SALT=random-long-secret

# Dispatch notification adapters.
# Each endpoint receives JSON with leadId, summary, lead and to.
DISPATCH_EMAIL_WEBHOOK_URL=
DISPATCH_EMAIL_TO=
DISPATCH_SMS_WEBHOOK_URL=
DISPATCH_SMS_TO=

# Jev classification through Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1/chat/completions

# Normalized JSON source adapters for the daily lead worker.
# Each configured endpoint should return an array with address + sourceUrl,
# plus any verified optional fields from the named public source.
TOWN_PALM_BEACH_PERMITS_URL=
PALM_BEACH_COUNTY_NOC_URL=
WEST_PALM_BEACH_PERMITS_URL=
FLORIDA_YIMBY_FEED_URL=
THE_REAL_DEAL_FEED_URL=

# Optional analytics
VITE_GA_TRACKING_ID=
VITE_ENVIRONMENT=development
